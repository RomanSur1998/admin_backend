NODE_ENV=development
PORT=3000

# postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=

# Сгенерировать: openssl rand -hex 32 (два разных значения)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
